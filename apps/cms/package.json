{
	"name": "@moslavac/cms",
	"version": "0.1.0",
	"description": "Payload CMS backend for clubs platform (multi-tenant)",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
		"dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 43102",
		"devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 43102",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
		"migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
		"migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
		"payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
		"start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 43102"
	},
	"dependencies": {
		"@payloadcms/db-postgres": "3.90.1",
		"@payloadcms/next": "3.90.1",
		"@payloadcms/plugin-multi-tenant": "3.90.1",
		"@payloadcms/richtext-lexical": "3.90.1",
		"@payloadcms/storage-s3": "3.90.1",
		"@payloadcms/ui": "3.90.1",
		"clsx": "^2.1.1",
		"cross-env": "^7.0.3",
		"dotenv": "^16.4.7",
		"framer-motion": "^12.38.0",
		"graphql": "^16.8.1",
		"lucide-react": "^1.7.0",
		"next": "^16.2.3",
		"openai": "^7.8.0",
		"payload": "3.90.1",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"server-only": "^0.0.1",
		"sharp": "^0.34.2",
		"tailwind-merge": "^3.5.0",
		"undici": "^6.25.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^22.19.9",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.16.0",
		"eslint-config-next": "^16.2.3",
		"pg": "^8.20.0",
		"prettier": "^3.4.2",
		"tailwindcss": "^4",
		"typescript": "^5.7.3"
	},
	"engines": {
		"node": "^18.20.2 || >=20.9.0",
		"pnpm": "^9 || ^10"
	}
}
