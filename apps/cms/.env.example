# Payload
PAYLOAD_SECRET=

# Postgres connection string (Neon, Supabase, local Postgres, ...)
DATABASE_URL=

# Cloudflare R2 (S3-compatible)
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Optional: comma-separated allowed CORS origins (frontend URLs). Defaults to *.
CORS_ORIGINS=

# Vercel Cron šalje ovo kao `Authorization: Bearer <secret>`.
CRON_SECRET=

# Izvještaji s utakmica. Bez ključa cron objavljuje samo šablonski tekst.
OPENAI_API_KEY=
# Neobavezno: preglasi model (zadano gpt-5.6-luna).
OPENAI_MATCH_REPORT_MODEL=

# Dijeljena tajna za /api/revalidate na klupskim stranicama. Kad urednik spremi
# sadržaj, CMS s njom javi stranici da osvježi cache. Ista vrijednost mora stajati
# i u env-u svakog klupskog projekta. Bez nje je ruta zatvorena i sadržaj čeka TTL.
REVALIDATE_SECRET=
