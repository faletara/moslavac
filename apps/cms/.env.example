# Payload
PAYLOAD_SECRET=

# Postgres connection string (Neon, Supabase, local Postgres, ...)
DATABASE_URL=

# Cloudflare R2 (S3-compatible)
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Optional: comma-separated allowed CORS origins (frontend URLs). Defaults to *.
CORS_ORIGINS=

# Vercel Cron šalje ovo kao `Authorization: Bearer <secret>`.
CRON_SECRET=

# Izvještaji s utakmica. Bez ključa cron objavljuje samo šablonski tekst.
OPENAI_API_KEY=
# Neobavezno: preglasi model (zadano gpt-5.6-luna).
OPENAI_MATCH_REPORT_MODEL=

# Glavna tajna za /api/revalidate na klupskim stranicama. Kad urednik spremi
# sadržaj, CMS javi stranici da osvježi cache. Klub ne dobiva ovu vrijednost nego
# vlastitu, izvedenu iz nje i sluga (docs/NEW-CLUB.md, korak 3). Bez nje CMS ne
# šalje revalidaciju i sadržaj čeka TTL.
REVALIDATE_SECRET=

# Admin origin (serverURL + csrf), npr. https://cms.example.hr. Obavezno u produkciji; lokalno default http://localhost:43102.
PAYLOAD_SERVER_URL=
# PAYLOAD_SERVER_URL ima prednost; bez nje se koriste VERCEL_BRANCH_URL, VERCEL_URL i VERCEL_PROJECT_PRODUCTION_URL (Vercel ih postavlja sam). next build ne pada bez njih.
# Hostovi klupskih stranica (zarezom odvojeni, npr. www.klub.hr,klub2.hr) na koje
# CMS smije slati revalidaciju. Prazno = revalidacija se ne šalje nikamo.
REVALIDATE_ALLOWED_HOSTS=
